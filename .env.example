# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# PAYREMINDER — CLÉS API SERVEUR UNIQUEMENT (NE JAMAIS PRÉFIXER PAR VITE_)
# À configurer dans Cloud Functions (.env / Secret Manager) et dans votre serveur Node.
# Si ces variables sont vides, PayReminder bascule automatiquement en mode simulation.
# ==============================================================================

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# --- Agrégateur SMS Cameroun (HTTP générique) ---
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PayReminder"

# --- Paiement Mobile Money (MTN MoMo / Orange Money / Agrégateur) ---
PAYMENT_PROVIDER_URL=""
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- Rapports mensuels par email (SMTP / Resend / Mailgun) ---
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM_ADDRESS="rapports@payreminder.cm"

# --- Sécurité des tâches planifiées (Cloud Scheduler -> Cloud Functions / API) ---
CRON_SECRET=""
