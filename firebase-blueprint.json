{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Index privé reliant un utilisateur authentifié à son entreprise (tenant).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "staff"],
          "maxLength": 16
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["uid", "tenantId", "role", "name", "email", "updatedAt"]
    },
    "TenantInvite": {
      "title": "TenantInvite",
      "description": "Invitation envoyée par un propriétaire pour ajouter un membre du personnel.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tenantName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["staff"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "revoked"],
          "maxLength": 16
        },
        "invitedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "tenantName", "email", "name", "role", "status", "invitedBy", "createdAt"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "Entreprise ou commerce abonné à PayReminder.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "sector": {
          "type": "string",
          "maxLength": 80
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\+[1-9][0-9]{7,15}$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "plan": {
          "type": "string",
          "enum": ["free", "starter", "pro", "business"],
          "maxLength": 20
        },
        "maxDebtors": {
          "type": "integer"
        },
        "maxRemindersPerMonth": {
          "type": "integer"
        },
        "remindersUsedThisMonth": {
          "type": "integer"
        },
        "quotaResetMonth": {
          "type": "string",
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "subscriptionDate": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "quietHoursStart": {
          "type": "integer"
        },
        "quietHoursEnd": {
          "type": "integer"
        },
        "timezone": {
          "type": "string",
          "maxLength": 40
        },
        "autoEscalate": {
          "type": "boolean"
        },
        "fallbackToSms": {
          "type": "boolean"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "name",
        "sector",
        "phone",
        "email",
        "plan",
        "maxDebtors",
        "maxRemindersPerMonth",
        "remindersUsedThisMonth",
        "quotaResetMonth",
        "subscriptionDate",
        "quietHoursStart",
        "quietHoursEnd",
        "timezone",
        "autoEscalate",
        "fallbackToSms",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "TenantUser": {
      "title": "TenantUser",
      "description": "Membre de l'équipe d'une entreprise (propriétaire ou personnel).",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["owner", "staff"],
          "maxLength": 16
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "maxLength": 20
        },
        "inviteId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "uid", "role", "name", "email", "status", "createdAt", "updatedAt"]
    },
    "Debtor": {
      "title": "Debtor",
      "description": "Client ou élève débiteur rattaché à une entreprise.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\+[1-9][0-9]{7,15}$"
        },
        "preferredChannel": {
          "type": "string",
          "enum": ["whatsapp", "sms"],
          "maxLength": 16
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "optOut": {
          "type": "boolean"
        },
        "reliabilityScore": {
          "type": "integer"
        },
        "promiseDate": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "name", "phone", "preferredChannel", "note", "optOut", "reliabilityScore", "createdAt", "updatedAt"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Créance client suivie en FCFA (XAF).",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorName": {
          "type": "string",
          "maxLength": 120
        },
        "debtorPhone": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^\\+[1-9][0-9]{7,15}$"
        },
        "initialAmount": {
          "type": "integer"
        },
        "remainingAmount": {
          "type": "integer"
        },
        "issuedAt": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "dueDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "status": {
          "type": "string",
          "enum": ["en_cours", "partiellement_payee", "payee", "en_retard", "annulee"],
          "maxLength": 24
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "reminderCount": {
          "type": "integer"
        },
        "lastReminderAt": {
          "type": "string",
          "maxLength": 40
        },
        "paymentLink": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": [
        "tenantId",
        "debtorId",
        "debtorName",
        "debtorPhone",
        "initialAmount",
        "remainingAmount",
        "issuedAt",
        "dueDate",
        "status",
        "description",
        "reminderCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Payment": {
      "title": "Payment",
      "description": "Paiement partiel ou total enregistré sur une dette.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorName": {
          "type": "string",
          "maxLength": 120
        },
        "amount": {
          "type": "integer"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "method": {
          "type": "string",
          "enum": ["especes", "mtn_momo", "orange_money", "autre"],
          "maxLength": 20
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "receiptNumber": {
          "type": "string",
          "maxLength": 40
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "debtId", "debtorId", "debtorName", "amount", "paidAt", "method", "note", "receiptNumber", "createdBy", "createdAt"]
    },
    "ReminderRule": {
      "title": "ReminderRule",
      "description": "Règle du calendrier de relance automatique.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "offsetDays": {
          "type": "integer"
        },
        "label": {
          "type": "string",
          "maxLength": 60
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "sms"],
          "maxLength": 16
        },
        "tone": {
          "type": "string",
          "enum": ["amical", "ferme", "dernier_avis"],
          "maxLength": 20
        },
        "allowedStartHour": {
          "type": "integer"
        },
        "allowedEndHour": {
          "type": "integer"
        },
        "maxReminders": {
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "offsetDays", "label", "channel", "tone", "allowedStartHour", "allowedEndHour", "maxReminders", "enabled", "updatedAt"]
    },
    "MessageTemplate": {
      "title": "MessageTemplate",
      "description": "Modèle de message de relance personnalisable.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tone": {
          "type": "string",
          "enum": ["amical", "ferme", "dernier_avis"],
          "maxLength": 20
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "sms"],
          "maxLength": 16
        },
        "body": {
          "type": "string",
          "maxLength": 1000
        },
        "metaTemplateName": {
          "type": "string",
          "maxLength": 80
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "tone", "channel", "body", "updatedAt"]
    },
    "Reminder": {
      "title": "Reminder",
      "description": "Relance planifiée ou exécutée pour une dette.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "scheduledAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "sms"],
          "maxLength": 16
        },
        "tone": {
          "type": "string",
          "enum": ["amical", "ferme", "dernier_avis"],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["planifiee", "envoyee", "delivree", "lue", "echouee", "annulee"],
          "maxLength": 20
        },
        "providerMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "debtId", "debtorId", "scheduledAt", "channel", "tone", "status", "providerMessageId", "createdAt", "updatedAt"]
    },
    "MessageLog": {
      "title": "MessageLog",
      "description": "Journal complet des messages envoyés, reçus et statuts de livraison.",
      "type": "object",
      "properties": {
        "tenantId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtId": {
          "type": "string",
          "maxLength": 128
        },
        "debtorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "debtorName": {
          "type": "string",
          "maxLength": 120
        },
        "debtorPhone": {
          "type": "string",
          "maxLength": 20
        },
        "reminderId": {
          "type": "string",
          "maxLength": 128
        },
        "direction": {
          "type": "string",
          "enum": ["outbound", "inbound"],
          "maxLength": 16
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "sms"],
          "maxLength": 16
        },
        "tone": {
          "type": "string",
          "maxLength": 20
        },
        "content": {
          "type": "string",
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["simule", "envoyee", "delivree", "lue", "echouee", "recue"],
          "maxLength": 20
        },
        "providerMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "detectedIntent": {
          "type": "string",
          "enum": ["opt_out", "promise", "none"],
          "maxLength": 20
        },
        "promiseDate": {
          "type": "string",
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        }
      },
      "required": ["tenantId", "debtorId", "debtorName", "debtorPhone", "direction", "channel", "content", "status", "providerMessageId", "detectedIntent", "createdAt"]
    }
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil utilisateur privé mappant uid vers tenantId et rôle."
    },
    "/tenantInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/TenantInvite" },
      "description": "Invitations du personnel par email."
    },
    "/tenants/{tenantId}": {
      "schema": { "$ref": "#/entities/Tenant" },
      "description": "Document principal de l'entreprise (tenant)."
    },
    "/tenants/{tenantId}/users/{userId}": {
      "schema": { "$ref": "#/entities/TenantUser" },
      "description": "Membres autorisés de l'entreprise."
    },
    "/tenants/{tenantId}/debtors/{debtorId}": {
      "schema": { "$ref": "#/entities/Debtor" },
      "description": "Débiteurs de l'entreprise."
    },
    "/tenants/{tenantId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/Debt" },
      "description": "Dettes de l'entreprise."
    },
    "/tenants/{tenantId}/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Paiements enregistrés."
    },
    "/tenants/{tenantId}/reminderRules/{ruleId}": {
      "schema": { "$ref": "#/entities/ReminderRule" },
      "description": "Règles de relance automatiques."
    },
    "/tenants/{tenantId}/messageTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/MessageTemplate" },
      "description": "Modèles de messages WhatsApp et SMS."
    },
    "/tenants/{tenantId}/reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/Reminder" },
      "description": "File et statut des relances."
    },
    "/tenants/{tenantId}/messageLogs/{logId}": {
      "schema": { "$ref": "#/entities/MessageLog" },
      "description": "Journal complet des échanges et conformité."
    }
  }
}
